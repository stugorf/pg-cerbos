# PG CERBOS Environment Configuration
# Copy this file to .env and modify as needed.

# PostgreSQL Configuration
PG_SUPERUSER=postgres
PG_SUPERPASS=postgres

# MinIO Configuration
MINIO_USER=minio
MINIO_PASS=minio123

# Application Configuration
SECRET_KEY=your-secret-key-change-in-production

# Graph backend configuration
GRAPH_ENGINE=puppygraph
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-password
NEO4J_DATABASE=
FUSEKI_URL=http://fuseki:3030
FUSEKI_DATASET=aml

# OpenAI natural-language query generation and chart suggestion.
# Pass these in .env; Docker Compose loads them into policy-registry-backend.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_GRAPH_QUERY=gpt-4o-mini
# OPENAI_MODEL_CYPHER=gpt-4o-mini
# OPENAI_MODEL_CHART=gpt-4o-mini
# OPENAI_BASE_URL=

# Optional: override default ports.
# POSTGRES_PORT=5434
# TRINO_COORDINATOR_PORT=8080
# POLICY_REGISTRY_PORT=8082
# POLICY_UI_PORT=8083
# CERBOS_PORT=3593
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# NESSIE_PORT=19120
